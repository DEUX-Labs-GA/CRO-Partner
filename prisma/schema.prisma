// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum ExperimentStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ExperimentTarget {
  PRODUCT_TITLE
  ADD_TO_CART_BUTTON
}

enum ExperimentChangeType {
  REPLACE_TEXT
}

enum MetricType {
  CONVERSION_RATE
  REVENUE
  AVERAGE_ORDER_VALUE
  CUSTOM
}

enum RecommendationStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

enum OpportunityStatus {
  RESEARCH_NEEDED
  READY_TO_TEST
  TESTING
  COMPLETED
  NOT_PURSUING
}

enum OpportunityConfidence {
  LOW
  MEDIUM
  HIGH
}

enum OpportunityImpact {
  LOW
  MEDIUM
  HIGH
}

enum ExperimentResultOutcome {
  INSUFFICIENT_DATA
  INCONCLUSIVE
  TREATMENT_LEADING
  CONTROL_LEADING
  NO_DIFFERENCE
}

enum ExperimentRecommendationAction {
  DEPLOY
  STOP
  ITERATE
  RETEST
  INVESTIGATE
  SEGMENT
  GATHER_MORE_DATA
}

enum ExperimentDecision {
  DEPLOY_TREATMENT
  KEEP_CONTROL
  ITERATE
  RETEST
  CONTINUE_TEST
  NO_ACTION
  OTHER
}

model Experiment {
  id                      String           @id @default(cuid())
  shop                    String
  name                    String
  hypothesis              String
  baselineConversionRate  Float?
  minimumDetectableEffect Float            @default(0.2)
  significanceLevel       Float            @default(0.95)
  statisticalPower        Float            @default(0.8)
  status                  ExperimentStatus @default(DRAFT)
  trackingKey             String?
  targetProductId         String?

  completedAt DateTime?

  resultOutcome  ExperimentResultOutcome?
  resultSummary  String?
  interpretation String?

  recommendationAction    ExperimentRecommendationAction?
  recommendationTitle     String?
  recommendationRationale String?

  decision ExperimentDecision?

  revenueImpact         Float?
  revenueImpactCurrency String?

  learning String?
  followUp String?

  variants  Variant[]
  metrics   Metric[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([shop])
}

model Variant {
  id           String  @id @default(cuid())
  experimentId String
  name         String
  isControl    Boolean @default(false)

  // Legacy title-specific treatment. Remove after migration.
  titleOverride String?

  target      ExperimentTarget?
  changeType  ExperimentChangeType?
  changeValue String?

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([experimentId])
}

model Metric {
  id           String     @id @default(cuid())
  experimentId String
  name         String
  type         MetricType
  isPrimary    Boolean    @default(false)
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([experimentId])
}

model Recommendation {
  id          String               @id @default(cuid())
  shop        String
  title       String
  description String
  status      RecommendationStatus @default(OPEN)
  source      String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([shop])
}

model Opportunity {
  id              String                @id @default(cuid())
  shop            String
  sourceRuleId    String
  productId       String?
  title           String
  observation     String
  evidence        String
  hypothesis      String
  recommendation  String
  confidence      OpportunityConfidence
  potentialImpact OpportunityImpact

  reach           Int
  impactScore     Float
  confidenceScore Float
  effort          Float
  priorityScore   Float

  status OpportunityStatus @default(RESEARCH_NEEDED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([shop, status])
  @@index([shop, priorityScore])
}

model BehaviorEvent {
  id                  String   @id @default(cuid())
  shop                String
  eventId             String
  eventName           String
  schemaVersion       String
  source              String
  sourceId            String?
  occurredAt          DateTime
  sequence            Int?
  clientId            String?
  pageUrl             String?
  pagePath            String?
  pageReferrer        String?
  pageTitle           String?
  productId           String?
  variantId           String?
  sku                 String?
  quantity            Float?
  value               Float?
  currency            String?
  checkoutToken       String?
  orderId             String?
  experimentId        String?
  experimentVariantId String?
  createdAt           DateTime @default(now())

  @@unique([shop, eventId])
  @@index([shop, eventName, occurredAt])
  @@index([shop, clientId])
}
