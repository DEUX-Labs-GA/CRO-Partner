// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

enum MetricType {
  CONVERSION_RATE
  REVENUE
  AVERAGE_ORDER_VALUE
  CUSTOM
}

enum RecommendationStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

model Experiment {
  id                      String           @id @default(cuid())
  shop                    String
  name                    String
  hypothesis              String
  baselineConversionRate  Float?
  minimumDetectableEffect Float            @default(0.2)
  significanceLevel       Float            @default(0.95)
  statisticalPower        Float            @default(0.8)
  status                  ExperimentStatus @default(DRAFT)
  variants                Variant[]
  metrics                 Metric[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([shop])
}

model Variant {
  id           String     @id @default(cuid())
  experimentId String
  name         String
  isControl    Boolean    @default(false)
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([experimentId])
}

model Metric {
  id           String     @id @default(cuid())
  experimentId String
  name         String
  type         MetricType
  isPrimary    Boolean    @default(false)
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([experimentId])
}

model Recommendation {
  id          String               @id @default(cuid())
  shop        String
  title       String
  description String
  status      RecommendationStatus @default(OPEN)
  source      String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([shop])
}

model BehaviorEvent {
  id            String   @id @default(cuid())
  shop          String
  eventId       String
  eventName     String
  schemaVersion String
  source        String
  sourceId      String?
  occurredAt    DateTime
  sequence      Int?
  clientId      String?
  pageUrl       String?
  pagePath      String?
  pageReferrer  String?
  pageTitle     String?
  productId     String?
  variantId     String?
  sku           String?
  quantity      Float?
  value         Float?
  currency      String?
  checkoutToken String?
  orderId       String?
  createdAt     DateTime @default(now())

  @@unique([shop, eventId])
  @@index([shop, eventName, occurredAt])
  @@index([shop, clientId])
}
